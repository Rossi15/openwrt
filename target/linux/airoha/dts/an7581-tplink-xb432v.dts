/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/phy/phy.h>
#include "an7581.dtsi"
#include "an7581-npu-mt7992.dtsi"

/ {
	model = "TP-Link XB432v";
	compatible = "tplink,xb432v", "airoha,an7581", "airoha,en7581";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		bootargs-append = "console=ttyS0,115200 earlycon root=/dev/ubiblock0_0";
		stdout-path = "serial0:115200n8";
		linux,usable-memory-range = <0x0 0x80200000 0x0 0x3fe00000>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
		};

		button-wifi {
			label = "wifi";
			linux,code = <KEY_WLAN>;
			gpios = <&en7581_pinctrl 23 GPIO_ACTIVE_LOW>;
		};

		button-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&en7581_pinctrl 4 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-power {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led-fiber-blue {
			color = <LED_COLOR_ID_BLUE>;
			label = "blue:fiber";
			gpios = <&en7581_pinctrl 18 GPIO_ACTIVE_LOW>;
		};

		led-fiber-red {
			color = <LED_COLOR_ID_RED>;
			label = "red:fiber";
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
		};

		led-internet-blue {
			color = <LED_COLOR_ID_BLUE>;
			label = "blue:internet";
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
		};

		/* GPIO for red "internet" LED is currently unknown
		led-internet-red {
			color = <LED_COLOR_ID_RED>;
			label = "red:internet";
			gpios = <&en7581_pinctrl 21 GPIO_ACTIVE_LOW>;
		};
		*/

		led-phone-blue {
			color = <LED_COLOR_ID_BLUE>;
			label = "blue:phone";
			gpios = <&en7581_pinctrl 24 GPIO_ACTIVE_LOW>;
		};

		/* GPIO for red "phone" LED is currently unknown
		led-phone-red {
			color = <LED_COLOR_ID_RED>;
			label = "red:phone";
			gpios = <&en7581_pinctrl 22 GPIO_ACTIVE_LOW>;
		}
		*/

		led-lan {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_LAN;
			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
		};

		led-wlan {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN;
			gpios = <&en7581_pinctrl 16 GPIO_ACTIVE_LOW>;
		};

		led-usb {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_USB;
			gpios = <&en7581_pinctrl 13 GPIO_ACTIVE_LOW>;
		};

		led-wan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 27 GPIO_ACTIVE_LOW>;
		};

		led-lan1 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <1>;
			gpios = <&en7581_pinctrl 46 GPIO_ACTIVE_LOW>;
		};
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};

		conf {
			pins = "gpio2";
			output-high;
		};
	};

	pcie0_rst_pins: pcie0-rst-pins {
		conf {
			pins = "pcie_reset0";
			drive-open-drain = <1>;
		};
	};

	pcie1_rst_pins: pcie1-rst-pins {
		conf {
			pins = "pcie_reset1";
			drive-open-drain = <1>;
		};
	};

	gswp2_led0_pins: gswp2-led0-pins {
		mux {
			function = "phy2_led0";
			pins = "gpio44";
		};
	};

	gswp3_led0_pins: gswp3-led0-pins {
		mux {
			function = "phy3_led0";
			pins = "gpio45";
		};
	};

	wan-enable-hog {
		gpio-hog;
		gpios = <42 GPIO_ACTIVE_LOW>;
		output-high;
		line-name = "wan-enable";
	};
};

&snfi {
	status = "okay";
};

&spi_nand {
	// airoha,bmt; not in openwrt upstream yet

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "boot";
			reg = <0x00000000 0x000c0000>;
			read-only;
		};

		partition@c0000 {
			label = "art";
			reg = <0x000c0000 0x00380000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				wifi_eeprom: eeprom@40000 {
					reg = <0x00040000 0x00001e00>;
				};
			};
		};

		partition@440000 {
			label = "misc";
			reg = <0x00440000 0x00400000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				base_mac: macaddr@8f100 {
					compatible = "mac-base";
					reg = <0x0008f100 0x6>;
					#nvmem-cell-cells = <1>;
				};
			};
		};

		partition@840000 {
			label = "kernel";
			reg = <0x00840000 0x00a00000>;
		};

		partition@1240000 {
			label = "ubi";
			reg = <0x01240000 0x03bc0000>;
		};

		partition@4e00000 {
			label = "kernel_slave";
			reg = <0x04e00000 0x00a00000>;
			read-only;
		};

		partition@5800000 {
			label = "rootfs_slave";
			reg = <0x05800000 0x03bc0000>;
			read-only;
		};

		partition@9bc0000 {
			label = "boot_flag";
			reg = <0x09bc0000 0x00040000>;
		};
	};
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_rst_pins>;
	status = "okay";
};

&pcie1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_rst_pins>;
	status = "okay";

	pcie@1,0 {
		reg = <0x0000 0 0 0 0>;
		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;

			#address-cells = <1>;
			#size-cells = <0>;

			airoha,npu = <&npu>;
			airoha,eth = <&eth>;

			nvmem-cells = <&wifi_eeprom>;
			nvmem-cell-names = "eeprom";

			band@0 {
				reg = <0>;

				// 2.4 GHz

				nvmem-cells = <&base_mac 3>;
				nvmem-cell-names = "mac-address";
			};

			band@1 {
				reg = <1>;

				// 5 GHz

				nvmem-cells = <&base_mac 4>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};

&npu {
	status = "okay";
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";

	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 2>;
};

&switch {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
	status = "okay";
};

&mdio {
	phy_wan_2g5: ethernet-phy@e {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0x0e>;

		reset-gpios = <&en7581_pinctrl 34 GPIO_ACTIVE_LOW>;
	};

	phy_lan_2g5: ethernet-phy@f {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0x0f>;

		reset-gpios = <&en7581_pinctrl 31 GPIO_ACTIVE_LOW>;
	};
};

&gsw_port2 {
	status = "okay";
	label = "lan2";
};

&gsw_phy2 {
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp2_led0_pins>;
	status = "okay";
};

&gsw_phy2_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <2>;
	active-low;
};

&gsw_port3 {
	status = "okay";
	label = "lan3";
};

&gsw_phy3 {
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp3_led0_pins>;
	status = "okay";
};

&gsw_phy3_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <3>;
	active-low;
};

&pon_pcs {
	status = "okay";
};

&eth_pcs {
	status = "okay";
};

&gdm4 {
	status = "okay";

	phy-handle = <&phy_lan_2g5>;
	phy-mode = "2500base-x";

	openwrt,netdev-name = "lan1";

	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 1>;
};

&gdm2 {
	status = "okay";

	phy-handle = <&phy_wan_2g5>;
	phy-mode = "2500base-x";

	openwrt,netdev-name = "wan";

	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 0>;
};

&usb0 {
	status = "okay";
};
